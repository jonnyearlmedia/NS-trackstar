{
  "key": "napa-city.etrakit",
  "name": "City of Napa eTRAKiT Permits and Planning Projects",
  "jurisdiction": "City of Napa",
  "adapter": "etrakit",
  "base_url": "https://etrakit.cityofnapa.org/etrakit",
  "poll_minutes": 240,
  "options": {
    "base_url": "https://etrakit.cityofnapa.org/etrakit",
    "canary_kinds": ["permit", "project"],
    "explicit_records": [],
    "searches": [],
    "discovery_partitions": [
      {
        "kind": "permit",
        "search_by_value": "Permit_Main.PERMIT_NO",
        "prefixes": ["B", "P", "M", "E"],
        "year_format": "%y",
        "years_back": 1,
        "max_pages": 5
      },
      {
        "kind": "project",
        "search_by_value": "Project_Main.PROJECT_NO",
        "prefixes": ["PL"],
        "year_format": "%y",
        "years_back": 1,
        "max_pages": 5
      }
    ],
    "max_candidates_per_run": 500,
    "min_request_interval_seconds": 1.0,
    "timezone": "America/Los_Angeles",
    "project_mapping": {
      "project_type": "municipal_development",
      "authority_type": "government_record",
      "name_fields": ["name", "description", "record_number"],
      "description_field": "description",
      "status_dimension": "official_tracker_stage",
      "status_field": "status",
      "assertions": {
        "description": "description",
        "address": "address",
        "apn": "apn",
        "source_project_type": "type",
        "record_type": "subtype",
        "official_status_text": "status",
        "application_submitted_at": "applied_date",
        "planner": "planner",
        "project_number": "record_number"
      }
    }
  }
}
