{
  "key": "rio-vista.granicus",
  "name": "City of Rio Vista Granicus Meetings and Agendas",
  "jurisdiction": "City of Rio Vista",
  "adapter": "granicus_rss",
  "base_url": "https://riovista-ca.granicus.com",
  "poll_minutes": 120,
  "options": {
    "base_url": "https://riovista-ca.granicus.com",
    "view_id": "1",
    "mode": "agendas",
    "min_expected_items": 10,
    "timeout_seconds": 30,
    "project_mapping": {
      "project_type": "government_meeting",
      "authority_type": "government_record",
      "name_fields": ["meeting_title"],
      "description_field": "summary",
      "assertions": {
        "description": "summary",
        "meeting_body": "meeting_body",
        "meeting_date": "meeting_date",
        "project_page": "agenda_url"
      }
    }
  }
}
