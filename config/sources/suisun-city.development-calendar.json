{
  "key": "suisun-city.development-calendar",
  "name": "Suisun City Development Calendar",
  "jurisdiction": "City of Suisun City",
  "adapter": "pdf_project_tracker",
  "base_url": "https://www.suisun.com/News-articles/Development-Calendar",
  "poll_minutes": 1440,
