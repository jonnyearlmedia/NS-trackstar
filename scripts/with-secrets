#!/bin/bash
set -euo pipefail

SERVICE="com.ns-trackstar.secrets"
KEYS=("BAYAREA_511_API_KEY" "COURTLISTENER_API_TOKEN")

if [[ $# -eq 0 ]]; then
  echo "Usage: ./scripts/with-secrets <command> [args...]" >&2
  exit 2
fi

# Explicit environment variables always win. On macOS, missing values fall back
# to the user's Keychain. Nothing is printed and child processes receive only
# the variables they need through their environment.
if [[ "$(uname -s)" == "Darwin" ]] && command -v security >/dev/null 2>&1; then
  for key in "${KEYS[@]}"; do
    if [[ -n "${!key:-}" ]]; then
      continue
    fi
    value="$(security find-generic-password -a "$key" -s "$SERVICE" -w 2>/dev/null || true)"
    if [[ -n "$value" ]]; then
      export "$key=$value"
    fi
    unset value
  done
fi

exec "$@"
