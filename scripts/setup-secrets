#!/bin/bash
set -euo pipefail

SERVICE="com.ns-trackstar.secrets"
KEYS=("BAYAREA_511_API_KEY" "COURTLISTENER_API_TOKEN")
LABELS=("511 Bay Area API token" "CourtListener API token")

require_macos() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    echo "NS Trackstar's no-env secret setup uses macOS Keychain and must be run on your Mac." >&2
    exit 1
  fi
  command -v security >/dev/null 2>&1 || { echo "macOS 'security' command is unavailable." >&2; exit 1; }
  command -v osascript >/dev/null 2>&1 || { echo "macOS 'osascript' command is unavailable." >&2; exit 1; }
}

has_secret() {
  security find-generic-password -a "$1" -s "$SERVICE" -w >/dev/null 2>&1
}

prompt_secret() {
  local label="$1"
  local existing="$2"
  osascript - "$label" "$existing" <<'APPLESCRIPT'
on run argv
  set labelText to item 1 of argv
  set existingText to item 2 of argv
  if existingText is "yes" then
    set promptText to labelText & " is already configured. Paste a replacement, or leave blank to keep the current value."
  else
    set promptText to "Paste your " & labelText & ". It will be stored in macOS Keychain and will not be printed."
  end if
  try
    set response to display dialog promptText default answer "" with hidden answer buttons {"Cancel", "Save"} default button "Save" with title "NS Trackstar Secrets"
    return text returned of response
  on error number -128
    return "__NS_TRACKSTAR_CANCELLED__"
  end try
end run
APPLESCRIPT
}

setup() {
  require_macos
  echo "NS Trackstar secret setup — no .env editing required."
  echo "Two secure macOS dialogs will open."
  echo

  local index key label existing value
  for index in "${!KEYS[@]}"; do
    key="${KEYS[$index]}"
    label="${LABELS[$index]}"
    existing="no"
    if has_secret "$key"; then
      existing="yes"
    fi

    value="$(prompt_secret "$label" "$existing")"
    if [[ "$value" == "__NS_TRACKSTAR_CANCELLED__" ]]; then
      echo "Cancelled. No secret was shown or copied into the shell."
      exit 1
    fi
    if [[ -z "$value" ]]; then
      if [[ "$existing" == "yes" ]]; then
        echo "✓ Kept existing $label"
      else
        echo "– Skipped $label"
      fi
      continue
    fi

    security add-generic-password -U -a "$key" -s "$SERVICE" -w "$value" >/dev/null
    unset value
    echo "✓ Saved $label to macOS Keychain"
  done

  echo
  check
}

check() {
  require_macos
  local index key label missing=0
  echo "NS Trackstar secret status:"
  for index in "${!KEYS[@]}"; do
    key="${KEYS[$index]}"
    label="${LABELS[$index]}"
    if has_secret "$key"; then
      echo "  ✓ $label configured"
    else
      echo "  ✗ $label missing"
      missing=1
    fi
  done
  return "$missing"
}

clear_all() {
  require_macos
  local answer
  answer="$(osascript <<'APPLESCRIPT'
try
  display dialog "Remove the 511 and CourtListener tokens stored for NS Trackstar from macOS Keychain?" buttons {"Cancel", "Remove"} default button "Cancel" with icon caution with title "NS Trackstar Secrets"
  return "remove"
on error number -128
  return "cancel"
end try
APPLESCRIPT
)"
  if [[ "$answer" != "remove" ]]; then
    echo "Nothing removed."
    exit 0
  fi

  local key
  for key in "${KEYS[@]}"; do
    security delete-generic-password -a "$key" -s "$SERVICE" >/dev/null 2>&1 || true
  done
  echo "Removed NS Trackstar API tokens from macOS Keychain."
}

case "${1:-setup}" in
  setup) setup ;;
  check|status) check ;;
  clear|remove) clear_all ;;
  *)
    echo "Usage: ./scripts/setup-secrets [setup|check|clear]" >&2
    exit 2
    ;;
esac
