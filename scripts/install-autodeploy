#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="${1:-$HOME/NS-trackstar}"
BRANCH="${NS_TRACKSTAR_DEPLOY_BRANCH:-build/phase-0-foundation}"
SERVICE_NAME="ns-trackstar-autodeploy"
RUNNER="/usr/local/sbin/${SERVICE_NAME}"
SERVICE_FILE="/etc/systemd/system/${SERVICE_NAME}.service"
TIMER_FILE="/etc/systemd/system/${SERVICE_NAME}.timer"

if [ ! -d "$REPO_DIR/.git" ]; then
  echo "Repo not found at $REPO_DIR" >&2
  exit 1
fi

if [ ! -f "$REPO_DIR/.env.production" ]; then
  echo "Missing $REPO_DIR/.env.production. Deploy the backend once before installing autodeploy." >&2
  exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is required." >&2
  exit 1
fi

CURRENT_USER="${SUDO_USER:-$USER}"
USER_HOME=$(getent passwd "$CURRENT_USER" | cut -d: -f6)
if [ -z "$USER_HOME" ]; then
  echo "Could not determine home directory for $CURRENT_USER" >&2
  exit 1
fi

sudo tee "$RUNNER" >/dev/null <<EOF
#!/usr/bin/env bash
set -euo pipefail
exec 9>/tmp/ns-trackstar-autodeploy.lock
flock -n 9 || exit 0
cd '$REPO_DIR'
git fetch --quiet origin '$BRANCH'
current=\$(git rev-parse HEAD)
target=\$(git rev-parse 'origin/$BRANCH')
if [ "\$current" = "\$target" ]; then
  exit 0
fi
git reset --hard "\$target"
./scripts/deploy-production.sh
EOF
sudo chmod 755 "$RUNNER"

sudo tee "$SERVICE_FILE" >/dev/null <<EOF
[Unit]
Description=NS Trackstar Git autodeploy
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=$CURRENT_USER
WorkingDirectory=$REPO_DIR
Environment=HOME=$USER_HOME
ExecStart=$RUNNER
EOF

sudo tee "$TIMER_FILE" >/dev/null <<EOF
[Unit]
Description=Check NS Trackstar branch for deployable updates

[Timer]
OnBootSec=90s
OnUnitActiveSec=2min
AccuracySec=20s
Persistent=true
Unit=${SERVICE_NAME}.service

[Install]
WantedBy=timers.target
EOF

sudo systemctl daemon-reload
sudo systemctl enable --now "${SERVICE_NAME}.timer"
sudo systemctl start "${SERVICE_NAME}.service"

echo "NS Trackstar autodeploy is installed."
echo "Branch: $BRANCH"
echo "Repo: $REPO_DIR"
echo "The VPS will check GitHub about every 2 minutes and redeploy only when this branch changes."
echo "Status: sudo systemctl status ${SERVICE_NAME}.timer --no-pager"
echo "Logs: sudo journalctl -u ${SERVICE_NAME}.service -n 100 --no-pager"
