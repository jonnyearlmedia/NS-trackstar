# Copying this file is optional. On the OVHcloud VM, scripts/deploy-production.sh
# creates .env.production interactively and generates the database password.
POSTGRES_DB=nstrackstar
POSTGRES_USER=nstrackstar
POSTGRES_PASSWORD=replace-with-a-long-url-safe-secret
API_DOMAIN=api.trackstar.example
CORS_ORIGINS=https://trackstar.example
CADDY_ACME_EMAIL=operator@example.com

# Optional source tokens. Leave unset and the sources that need them simply do not
# run; nothing else is affected. scripts/deploy-production.sh preserves whatever is
# already here and never prints a value.
# BAYAREA_511_API_KEY=
# COURTLISTENER_API_TOKEN=
